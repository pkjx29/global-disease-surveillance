# ${API_UPSTREAM} and ${API_KEY} are substituted at container start (nginx image template mechanism).

# Browsers share the dashboard's API key, so they are rate-limited per client IP here instead.
limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=10r/s;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header X-API-Key "${API_KEY}";    # added server-side: the browser never sees the key
        limit_req zone=api_per_ip burst=40 nodelay;  # page load fires ~15 requests at once
        limit_req_status 429;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";
        proxy_buffering off;            # required for the Server-Sent Events alert stream
        proxy_read_timeout 1h;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        try_files $uri /index.html;
    }
}
